{
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "wrangler": "^4.162.0"
  },
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/neon-backend.mjs",
    "neon:setup": "node scripts/neon-database.mjs",
    "neon:seed": "node scripts/neon-backend.mjs --seed",
    "start:frontend": "npm --prefix frontend run start:neon",
    "neon:import": "node scripts/neon-import.mjs",
    "render:env": "node scripts/render-env.mjs",
    "test:deployment": "node --test scripts/deployment.test.mjs",
    "pages:build": "wrangler pages functions build functions --cwd frontend --outdir=../.pages-build --build-output-directory=dist/frontend/browser --project-directory=."
  }
}
